package com.nammasanthe.ledger.ui.screens

import androidx.compose.foundation.layout.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import com.nammasanthe.ledger.viewmodel.OcrViewModel

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SimpleTestScreen(
    ocrViewModel: OcrViewModel,
    onBack: () -> Unit
) {
    val state by ocrViewModel.state.collectAsStateWithLifecycle()

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Ultimate OCR Test") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Text("←")
                    }
                }
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .padding(padding)
                .padding(16.dp)
                .fillMaxSize(),
            verticalArrangement = Arrangement.spacedBy(16.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Text("Ultimate OCR System", style = MaterialTheme.typography.headlineMedium)
            Text("Testing maximum accuracy for Kannada text")
            
            if (state.processing) {
                LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
                Text("Processing OCR...")
            }
            
            state.error?.let { error ->
                Text("Error: $error", color = MaterialTheme.colorScheme.error)
            }
            
            state.warning?.let { warning ->
                Text("Warning: $warning", color = MaterialTheme.colorScheme.secondary)
            }
            
            Text("Language: ${state.language}")
            Text("Source: ${state.source}")
            Text("Confidence: ${(state.confidence * 100).toInt()}%")
            
            state.amount?.let { amount ->
                Text("Amount: ₹$amount")
            }
            
            Text("Original Text:")
            Text(state.original ?: "No text")
            
            Text("Translated Text:")
            Text(state.translated ?: "No translation")
            
            Text("Parsed Items: ${state.parsedItems.size}")
            
            Button(
                onClick = { 
                    // Test OCR functionality
                }
            ) {
                Text("Test OCR")
            }
        }
    }
}
