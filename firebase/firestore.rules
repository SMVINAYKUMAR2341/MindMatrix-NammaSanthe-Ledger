rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — authenticated users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections under user (profile, customers, transactions)
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // QR Confirmations — anyone can write (customer doesn't need login)
      // but only the document owner can read
      match /confirmations/{txnId} {
        // Anyone can create a new confirmation (customer via web page)
        // But cannot overwrite existing (prevents replay attacks)
        allow create: if true;

        // Only the authenticated owner can read confirmations
        allow read: if request.auth != null && request.auth.uid == userId;

        // No updates or deletes allowed (immutable records)
        allow update, delete: if false;
      }
    }
  }
}
